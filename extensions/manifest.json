{
    "manifest_version": 3,
    "name": "Cyber-Twin",
    "version": "1.0.0",
    "action": {
        "default_popup": "popup.html"
    },
    "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
],
    "content_scripts": [
        {
            "matches": ["https://x.com/*",
                        "https://twitter.com/*"],
            "js": ["content.js"]
        }
    ]
}